# === spring-saas-core — Railway Environment Variables ===
# Copie para as variáveis do Railway (Settings > Variables)
# Checklist go-live: fluxe-b2b-suite/docs/GO-LIVE-VENDA.md

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL (Railway managed — use ${{Postgres.DATABASE_URL}})
DB_URL=${{Postgres.JDBC_DATABASE_URL}}
DB_USER=${{Postgres.PGUSER}}
DB_PASS=${{Postgres.PGPASSWORD}}
SPRING_LIQUIBASE_CONTEXTS=prod

# Redis (Railway managed — use ${{Redis.REDIS_URL}})
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

# RabbitMQ (CloudAMQP free tier ou Railway plugin)
RABBITMQ_HOST=your-rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_USER=your-user
RABBITMQ_PASS=your-pass

# CORS — lista exata de origens dos frontends (produção). Ex.: https://app.fluxe.com.br,https://admin.fluxe.com.br,https://ops.fluxe.com.br
CORS_ALLOWED_ORIGINS=https://shop.up.railway.app,https://admin-console.up.railway.app,https://ops-portal.up.railway.app

# Auth — PRODUÇÃO: preferir OIDC (Keycloak/Auth0). Se hs256, usar JWT_HS256_SECRET forte (openssl rand -base64 32)
AUTH_MODE=oidc
JWT_HS256_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET
JWT_ISSUER=spring-saas-core

# OIDC (produção — quando AUTH_MODE=oidc)
OIDC_ISSUER_URI=https://auth.seudominio.com.br/realms/fluxe
OIDC_JWK_SET_URI=https://auth.seudominio.com.br/realms/fluxe/protocol/openid-connect/certs
OIDC_CLIENT_ID=spring-saas-core
OIDC_AUDIENCE=account

# Billing (Stripe) — obrigatório para assinaturas em produção
STRIPE_BILLING_SECRET_KEY=sk_live_xxx
# app.billing.provider=stripe (ou via application-prod.yml)

# Email transacional (Resend) — convite, reset senha, boas-vindas. Ver docs/CONVITE-EMAIL-DEPLOY.md
# EMAIL_FROM deve usar EXATAMENTE o domínio ou subdomínio verificado em resend.com/domains
# Testar antes: ./scripts/test-resend.sh seu@email.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@mail.fluxe.com.br
EMAIL_FROM_NAME=Fluxe B2B Suite
FRONTEND_URL=https://admin.seudominio.com.br

# AI (opcional)
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Dev token — OBRIGATÓRIO false em produção
APP_DEV_TOKEN_ENDPOINT_ENABLED=false
