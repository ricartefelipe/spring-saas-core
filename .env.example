# === Spring SaaS Core - Environment Variables ===
# Valores para rodar no HOST (local). Para Docker o compose injeta hostnames (postgres, redis, rabbitmq).
# Referência: fluxe-b2b-suite/config/env/README.md e docs/CONFIG-AMBIENTES.md

# Spring Profiles: local | staging | prod
SPRING_PROFILES_ACTIVE=local

# Database (PostgreSQL) — porta 5435 = host (docker-compose mapeia 5435:5432)
DB_URL=jdbc:postgresql://localhost:5435/saascore
DB_USER=saascore
DB_PASS=saascore

# Authentication Mode: hs256 | oidc
AUTH_MODE=hs256

# JWT Configuration
JWT_ISSUER=spring-saas-core
JWT_HS256_SECRET=local-dev-secret-min-32-chars-for-hs256-signing
# Optional: previous secret for zero-downtime rotation (JWT_SECRET_PREVIOUS or JWT_HS256_SECRET_PREVIOUS)
# JWT_SECRET_PREVIOUS=

# OIDC (only when AUTH_MODE=oidc)
# OIDC_ISSUER_URI=https://keycloak.example.com/realms/saas
# OIDC_JWK_SET_URI=https://keycloak.example.com/realms/saas/protocol/openid-connect/certs

# Redis — porta 6382 no host (suite padrão: fluxe-b2b-suite/config/env/portas-local.md)
REDIS_HOST=localhost
REDIS_PORT=6382

# RabbitMQ — porta 5675 no host
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5675
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Outbox publishing
OUTBOX_PUBLISH_ENABLED=false

# Logging
# LOG_FORMAT=json  (use prod profile for JSON logging)

# OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Email (convites, reset de senha). Padrão log = não envia; resend = envia via Resend (obrigatório em staging/prod)
EMAIL_PROVIDER=log
# RESEND_API_KEY=re_xxx
# FRONTEND_URL=https://admin-console.seudominio.com
# EMAIL_FROM=noreply@fluxe.com.br

# Assistente IA (Admin) — opcional. LLM só com AI_ENABLED=true e OPENAI_API_KEY não vazio.
# AI_ENABLED=false
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Server
SERVER_PORT=8080
