# === spring-saas-core — Railway staging (exemplo) ===
# O Dockerfile define SPRING_PROFILES_ACTIVE=staging por defeito; pode omitir ou fixar aqui.

SPRING_PROFILES_ACTIVE=staging
SERVER_PORT=8080

# PostgreSQL, Redis, RabbitMQ, JWT, CORS, e-mail — ver docs/TROUBLESHOOT-RAILWAY.md e CONVITE-EMAIL-DEPLOY.md

# --- Assistente IA (Admin Console → /v1/ai/*) ---
# O Core só chama o LLM se AI_ENABLED=true (default em staging) E OPENAI_API_KEY não vazio.
# Cria a chave em https://platform.openai.com/api-keys (ou API compatível com /v1/chat/completions).
# Permissão ABAC: analytics:read (já no seed 008 para utilizadores com políticas essenciais).
AI_ENABLED=true
OPENAI_API_KEY=
# Opcional: proxy OpenAI-compatible (LiteLLM, Azure, etc.)
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
